# Copy this file to .env (same folder) and fill in the values.
# .env is git-ignored, so your keys stay on your machine.

# Signs the login cookie. Use a long random string in production:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# AI companion (https://openrouter.ai/keys). Leave empty to run without it:
# the floating tips fall back to rules based on your data and the Debrief
# tab explains how to connect.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-sonnet-4.5

# Leave empty to use SQLite at backend/instance/anchor.db.
# On Railway, add a Postgres database and this is set for you.
DATABASE_URL=

# Set to true when serving over HTTPS (Railway does).
SESSION_COOKIE_SECURE=
